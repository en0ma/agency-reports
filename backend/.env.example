APP_ENV=local
LOG_LEVEL=INFO
# Local stand-in for the Databricks SQL warehouse, built by `python manage.py load_warehouse`.
WAREHOUSE_DB_PATH=../data/warehouse.sqlite3
WAREHOUSE_DATA_DIR=../data/warehouse
# Only used when APP_ENV is dev/devqa/test/prod. Never commit a real token.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
